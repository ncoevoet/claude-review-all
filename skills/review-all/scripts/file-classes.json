    ],
    "**/*middleware*/**": [
      "security"
    ],
    "**/*auth*": [
      "security"
    ],
    "**/*login*": [
      "security"
    ],
    "**/*session*": [
      "security"
    ],
    "**/*token*": [
      "security"
    ],
    "**/*crypto*": [
      "security"
    ],
    "**/*jwt*": [
      "security"
    ],
    "**/*permission*": [
      "security"
    ],
    "**/*guard*": [
      "security"
    ],
    "**/*middleware*": [
      "security"
    ],
    "**/Dockerfile*": [
      "security"
    ],
    "**/docker-compose*.{yml,yaml}": [
      "security"
    ],
    ".github/workflows/**": [
      "security"
    ]
  },
  "content_signals": {
    "security": [
      "\\.(?:innerHTML|outerHTML)\\s*=",
      "insertAdjacentHTML\\(",
      "document\\.write\\(",
      "\\bexecSync\\(",
      "\\bexecFileSync\\(",
      "\\bexecFile\\(",
      "\\bspawnSync\\(",
      "from [\\\"']child_process[\\\"']",
      "require\\([\\\"']child_process[\\\"']\\)",
      "\\breadFileSync\\(\\s*join\\(",
      "\\bwriteFileSync\\(\\s*join\\(",
      "(?<!\\.)\\bfetch\\(\\s*\\w+\\s*[,)]",
      "(?<!\\.)\\brequest\\(\\s*\\w+\\s*,",
      "axios\\.get\\(\\s*\\w+\\s*\\)",
      "http\\.get\\(\\s*\\w+\\s*,",
      "rejectUnauthorized:\\s*false",
      "NODE_TLS_REJECT_UNAUTHORIZED",
      "checkServerIdentity\\s*:\\s*\\(\\s*\\)\\s*=>",
      "/\\[\",\\\\n\\\\r\\]/",
      "escapeField\\("
    ]
  },
  "rule_packs": {
    "**/*.{ts,tsx,js,jsx,mjs,cjs}": "ts_js.md",
    "**/*.java": "java.md",
    "**/*.{py,pyi}": "python.md",
    "**/*.go": "go.md",
    "**/*.rs": "rust.md",
    "**/*.sql": "sql.md",
    "**/*.{json,json5}": "json.md",
    "**/*.{md,mdx}": "markdown.md",
    "**/*": "default.md"
  }
}
